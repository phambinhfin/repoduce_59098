diff --git a/vllm/v1/attention/backends/utils.py b/vllm/v1/attention/backends/utils.py
index c97483912d..0e0b1e3160 100644
--- a/vllm/v1/attention/backends/utils.py
+++ b/vllm/v1/attention/backends/utils.py
@@ -778,6 +778,14 @@ def split_decodes_prefills_and_extends(
             0,
         )
 
+    # The batch order cannot always put every request with context ahead of the
+    # first context-less one (padded draft rows must stay at the front), so keep
+    # the prefill region clear of any request that has context.
+    has_context = (seq_lens != query_lens) & (query_lens > 0)
+    context_rows = torch.nonzero(has_context).flatten()
+    if context_rows.numel() > 0:
+        first_prefill = max(first_prefill, int(context_rows[-1]) + 1)
+
     num_extends = first_prefill - num_decodes
     num_prefills = num_reqs - first_prefill
 
diff --git a/vllm/v1/worker/gpu/model_runner.py b/vllm/v1/worker/gpu/model_runner.py
index 8bcaa01d1f..e776957efd 100644
--- a/vllm/v1/worker/gpu/model_runner.py
+++ b/vllm/v1/worker/gpu/model_runner.py
@@ -1248,7 +1248,11 @@ class GPUModelRunner(LoRAModelRunnerMixin):
         draft_tokens = scheduler_output.scheduled_spec_decode_tokens
         # batch_idx -> req_id
         req_ids = sort_batch_req_ids(
-            num_tokens_per_req, draft_tokens, self.decode_query_len
+            num_tokens_per_req,
+            draft_tokens,
+            self.decode_query_len,
+            self.req_states.num_computed_tokens_np,
+            self.req_states.req_id_to_index,
         )
 
         numtoks_iter = map(num_tokens_per_req.__getitem__, req_ids)
@@ -2383,12 +2387,37 @@ def sort_batch_req_ids(
     num_tokens_per_req: dict[str, int],
     draft_tokens: dict[str, list[int]],
     decode_query_len: int,
+    num_computed_tokens: np.ndarray | None = None,
+    req_id_to_index: dict[str, int] | None = None,
 ) -> list[str]:
-    # Order verification/decode -> short_extend -> prefill;
-    # split_decodes_and_prefills relies on decode-like requests leading.
-    key = lambda r: (
-        not draft_tokens.get(r),
-        (num := num_tokens_per_req[r]) != decode_query_len,
-        num,
-    )
+    # Order verification/decode -> short_extend -> extend -> prefill.
+    # Keeping requests that have context ahead of context-less ones lets
+    # split_decodes_prefills_and_extends end the extend region as early as
+    # possible; the splitter clamps the boundary itself, so this is a tightening
+    # rather than a correctness requirement. The context term precedes the
+    # decode-length term because split_dcp_context_queries splits at
+    # decode_threshold=1, where a context-less decode_query_len chunk is a prefill.
+    def key(r: str) -> tuple[bool, bool, bool, int]:
+        num = num_tokens_per_req[r]
+        drafts = draft_tokens.get(r)
+        return (
+            not drafts,
+            # Requests that fit in a decode chunk stay with the decodes, and
+            # drafted requests are pinned ahead of everything by the term above,
+            # so neither needs the lookup. The scheduler only pads a 1-token
+            # prompt with drafts, so a fresh 2..decode_query_len prompt is
+            # undrafted: sorting it behind the extends would make it a
+            # zero-context extend, which costs a context chunk it has no use for
+            # and raises num_extends for the requests that do. `not` keeps the
+            # numpy scalar out of the tuple: sorting compares tuples O(n log n)
+            # times, and numpy scalars compare far slower.
+            num > decode_query_len
+            and not drafts
+            and num_computed_tokens is not None
+            and req_id_to_index is not None
+            and not num_computed_tokens[req_id_to_index[r]],
+            num != decode_query_len,
+            num,
+        )
+
     return sorted(num_tokens_per_req, key=key)
